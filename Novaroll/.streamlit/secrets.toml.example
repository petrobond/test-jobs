# Пример для Streamlit Cloud (Manage app -> Settings -> Secrets).
# Скопируйте значения в UI Streamlit Cloud. Файл secrets.toml в git не попадает.

DEEPSEEK_API_KEY = "sk-..."
DEEPSEEK_MODEL_LIGHT = "deepseek-flash"
DEEPSEEK_MODEL_HEAVY = "deepseek-v4-pro"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"

# OpenAI (для генерации синтетики, когда есть валидный ключ)
OPENAI_API_KEY = ""
OPENAI_MODEL_LIGHT = "gpt-4o"
OPENAI_MODEL_HEAVY = "gpt-6-sol"
OPENAI_BASE_URL = "https://api.openai.com/v1"

EXTRACT_PROVIDER = "deepseek"
EXTRACT_TIER = "cheap"
GEN_PROVIDER = "deepseek"
GEN_TIER = "expensive"
CONFIDENCE_THRESHOLD = "0.75"
