# Пример локального окружения. Скопируйте в .env и подставьте свои ключи.
# Для Streamlit Cloud те же ключи задаются в разделе Secrets (st.secrets).

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_LIGHT=deepseek-flash
DEEPSEEK_MODEL_HEAVY=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_MODEL_LIGHT=gpt-4o
OPENAI_MODEL_HEAVY=gpt-6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Кто что делает (разные LLM для «чистоты эксперимента»):
EXTRACT_PROVIDER=deepseek
EXTRACT_TIER=cheap
GEN_PROVIDER=openai
GEN_TIER=cheap

CONFIDENCE_THRESHOLD=0.75
